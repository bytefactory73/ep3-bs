<?= $this->partial('team-stats-modal-script') ?>
<script>
function getCurrentBookingSpieltag() {
    var bookingSelect = document.getElementById('spieltag-select');
    if (!bookingSelect) return '';
    var value = String(bookingSelect.value || '').trim();
    return value === '__new__' ? '' : value;
}

window.teamSpieltagUpdateFromApi = function(data) {
    var select = document.getElementById('spieltag-select');
    if (!select || !data || !data.success) return;
    var selected = data.current_spieltag || '';
    var options = Array.isArray(data.open_spieltage) ? data.open_spieltage : [];

    while (select.firstChild) {
        select.removeChild(select.firstChild);
    }
    for (var i = 0; i < options.length; i++) {
        var name = String(options[i] || '').trim();
        if (!name) continue;
        var opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        if (name === selected) opt.selected = true;
        select.appendChild(opt);
    }
    // If there are no other spieltage (or only one), add a neutral placeholder
    // so the user can choose the "Neuen Spieltag anlegen" option.
    if (options.length <= 1) {
        var placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '---';
        // Insert placeholder at the top so it's selectable when nothing else should be preselected
        select.insertBefore(placeholder, select.firstChild);
        // If nothing selected yet, make the placeholder the selected value
        if (!selected) placeholder.selected = true;
    }
    var newOpt = document.createElement('option');
    newOpt.value = '__new__';
    newOpt.textContent = 'Neuen Spieltag anlegen';
    select.appendChild(newOpt);

};

var teamStatsModalController = createTeamStatsModal({
    id: 'theke-team-stats',
    buildStatsUrl: function(teamEvent) {
        return 'simple-order/team-stats' + (teamEvent ? '?spieltag=' + encodeURIComponent(teamEvent) : '');
    },
    // Opens on the Spieltag selected for booking
    getInitialEventId: getCurrentBookingSpieltag,
    endpoints: {
        members: 'simple-order/team-members',
        orderRelevance: 'simple-order/team-order-relevance',
        extraCost: 'simple-order/team-extra-cost',
        updateExtraCost: 'simple-order/team-update-extra-cost',
        deleteExtraCost: 'simple-order/team-delete-extra-cost',
        guestDonation: 'simple-order/team-guest-donation',
        updateGuestDonation: 'simple-order/team-update-guest-donation',
        deleteGuestDonation: 'simple-order/team-delete-guest-donation',
        closeEvent: 'simple-order/close-team-event'
    },
    // The booking dropdown only lists open Spieltage
    onTeamEventClosed: function() {
        fetch('simple-order/spieltag', {
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(resp) { return resp.json(); })
        .then(window.teamSpieltagUpdateFromApi)
        .catch(function() {});
    }
});

function openTeamStatsModal() {
    return teamStatsModalController.open();
}

function openDrinksSummaryModal() {
    var now = new Date();
    var fromDateObj = new Date(now.getTime() - 6 * 24 * 60 * 60 * 1000);
    var fromDate = fromDateObj.toISOString().slice(0, 10);
    // Open summary with explicit quick range and mode so UI reflects state immediately
    var summaryUrl = './drinks-summary?quick=sinceLastCheck&mode=count';
    document.getElementById('drinksSummaryModal').style.display = 'flex';
    document.getElementById('drinksSummaryFrame').src = summaryUrl;
    // Reset logout timer to 30 minutes if in simple order mode
    if (window.SIMPLE_ORDER_MODE && typeof localStorage !== 'undefined') {
        var deadlineKey = 'simpleOrderLogoutDeadline';
        var LOGOUT_DELAY = 30 * 60 * 1000; // 30 minutes
        var deadline = Date.now() + LOGOUT_DELAY;
        localStorage.setItem(deadlineKey, deadline);
        if (typeof startLogoutTimer === 'function') {
            startLogoutTimer();
        }
    }
}
function closeDrinksSummaryModal() {
    document.getElementById('drinksSummaryModal').style.display = 'none';
    document.getElementById('drinksSummaryFrame').src = '';
}
</script>
</body>
</html>
