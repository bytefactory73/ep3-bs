</div>
<script src="<?= $this->basePath('js/team-stats-modal.js?v=20260608-13') ?>"></script>
<script>
function getCurrentBookingSpieltag() {
    var bookingSelect = document.getElementById('spieltag-select');
    if (!bookingSelect) return '';
    var value = String(bookingSelect.value || '').trim();
    return value === '__new__' ? '' : value;
}

function syncTeamStatsSpieltagSelect(preferredValue) {
    // Keep this helper minimal to avoid overwriting the modal dropdown
    // with the booking select options before the API response arrives.
    var modalSelect = document.getElementById('team-stats-spieltag-select');
    if (!modalSelect) return '';
    if (!preferredValue) return '';

    var selected = String(preferredValue).trim();
    if (!selected || selected === '__new__') {
        return '';
    }

    var existing = false;
    for (var i = 0; i < modalSelect.options.length; i++) {
        var optionLabel = String(modalSelect.options[i].getAttribute('data-label') || '').trim();
        if (String(modalSelect.options[i].value || '').trim() === selected || optionLabel === selected) {
            existing = true;
            selected = String(modalSelect.options[i].value || '').trim();
            break;
        }
    }
    if (!existing) {
        var opt = document.createElement('option');
        opt.value = selected;
        opt.textContent = selected;
        modalSelect.appendChild(opt);
    }
    modalSelect.value = selected;
    return selected;
}

window.teamSpieltagUpdateFromApi = function(data) {
    var select = document.getElementById('spieltag-select');
    if (!select || !data || !data.success) return;
    var selected = data.current_spieltag || '';
    var options = Array.isArray(data.open_spieltage) ? data.open_spieltage : [];

    while (select.firstChild) {
        select.removeChild(select.firstChild);
    }
    for (var i = 0; i < options.length; i++) {
        var name = String(options[i] || '').trim();
        if (!name) continue;
        var opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        if (name === selected) opt.selected = true;
        select.appendChild(opt);
    }
    // If there are no other spieltage (or only one), add a neutral placeholder
    // so the user can choose the "Neuen Spieltag anlegen" option.
    if (options.length <= 1) {
        var placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '---';
        // Insert placeholder at the top so it's selectable when nothing else should be preselected
        select.insertBefore(placeholder, select.firstChild);
        // If nothing selected yet, make the placeholder the selected value
        if (!selected) placeholder.selected = true;
    }
    var newOpt = document.createElement('option');
    newOpt.value = '__new__';
    newOpt.textContent = 'Neuen Spieltag anlegen';
    select.appendChild(newOpt);

};

var teamStatsModalController = createTeamStatsModal({
    modalId: 'teamStatsModal',
    contentId: 'teamStatsContent',
    balanceHeaderId: 'team-stats-account-balance-header',
    selectId: 'team-stats-spieltag-select',
    memberInputId: 'team-stats-member-search',
    memberListId: 'team-stats-member-list',
    memberAddBtnId: 'team-stats-member-add',
    memberClearBtnId: 'team-stats-member-clear',
    rowClass: 'team-stats-member-row',
    removeButtonClass: 'team-stats-member-remove',
    addDirectButtonClass: 'team-stats-member-add-direct',
    buildStatsUrl: function(selectedSpieltag) {
        if (selectedSpieltag === '__new__') {
            throw new Error('Bitte zuerst einen Spieltag auswählen.');
        }
        var url = 'simple-order/team-stats';
        if (selectedSpieltag) {
            url += '?spieltag=' + encodeURIComponent(selectedSpieltag);
        }
        return url;
    },
    endpoints: {
        members: 'simple-order/team-members',
        orderRelevance: 'simple-order/team-order-relevance',
        extraCost: 'simple-order/team-extra-cost',
        updateExtraCost: 'simple-order/team-update-extra-cost',
        deleteExtraCost: 'simple-order/team-delete-extra-cost',
        guestDonation: 'simple-order/team-guest-donation',
        updateGuestDonation: 'simple-order/team-update-guest-donation',
        deleteGuestDonation: 'simple-order/team-delete-guest-donation',
        closeEvent: 'simple-order/close-team-event'
    },
    onTeamEventClosed: function() {
        fetch('simple-order/spieltag', {
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
            if (typeof window.teamSpieltagUpdateFromApi === 'function') {
                window.teamSpieltagUpdateFromApi(data);
            }
        })
        .catch(function() {});
    },
    afterLoadData: function(data, state, refs) {
        if (!refs.select) return;
        while (refs.select.firstChild) {
            refs.select.removeChild(refs.select.firstChild);
        }
        var spieltage = Array.isArray(data.spieltage) ? data.spieltage : [];
        var openSpieltage = Array.isArray(data.open_spieltage) ? data.open_spieltage : [];
        var selectedSpieltag = String(data.spieltag || '').trim();
        
        // Build a map of event label -> role from the events array
        var eventRoleMap = {};
        var events = Array.isArray(data.events) ? data.events : [];
        for (var ei = 0; ei < events.length; ei++) {
            var eventLabel = String(events[ei].label || '').trim();
            var eventRole = events[ei].role || (events[ei].can_manage_members ? 'Mannschaftsführer' : 'Mitglied');
            if (eventLabel) {
                eventRoleMap[eventLabel] = eventRole;
            }
        }
        
        // One option per Spieltag (value = event id): labels are not unique across teams.
        // The server accepts a numeric spieltag as team event id.
        var selectedEventId = parseInt(data.team_event_id || 0, 10);
        if (events.length > 0) {
            var seenEventIds = {};
            for (var ev = 0; ev < events.length; ev++) {
                var evId = parseInt(events[ev].id || 0, 10);
                var evLabel = String(events[ev].label || '').trim();
                if (!evId || !evLabel || seenEventIds[evId]) continue;
                seenEventIds[evId] = true;
                var evOpt = document.createElement('option');
                evOpt.value = String(evId);
                evOpt.setAttribute('data-label', evLabel);
                var evAlias = String(events[ev].team_alias || '').trim();
                var evText = evAlias !== '' ? (evAlias + ' - ' + evLabel) : evLabel;
                if (!parseInt(events[ev].closed || 0, 10)) {
                    evText += ' (offen)';
                }
                evOpt.textContent = evText;
                evOpt.setAttribute('data-user-role', events[ev].role || (events[ev].can_manage_members ? 'Mannschaftsführer' : 'Mitglied'));
                evOpt.setAttribute('data-team-alias', evAlias);
                if (selectedEventId > 0 ? evId === selectedEventId : evLabel === selectedSpieltag) evOpt.selected = true;
                refs.select.appendChild(evOpt);
            }
            refs.select.disabled = refs.select.options.length === 0;
            return;
        }

        for (var i = 0; i < spieltage.length; i++) {
            var name = String(spieltage[i] || '').trim();
            if (!name) continue;
            var opt = document.createElement('option');
            opt.value = name;
            var isOpen = openSpieltage.indexOf(name) !== -1;
            // Find team alias for this event to show in front (e.g., "MF - Team - Teamevent")
            var teamAlias = '';
            var eventRole = eventRoleMap[name] || (isOpen ? 'Mannschaftsführer' : 'Mitglied');
            for (var ej = 0; ej < events.length; ej++) {
                if (String(events[ej].label || '').trim() === name) {
                    var alias = String(events[ej].team_alias || '').trim();
                    if (alias !== '') {
                        teamAlias = alias;
                    }
                    eventRole = events[ej].role || eventRole;
                    break;
                }
            }
            // Display team alias in front of event label (e.g., "MF - Team - Teamevent")
            var displayText = name;
            if (teamAlias !== '') {
                displayText = teamAlias + ' - ' + name;
            }
            if (isOpen) {
                displayText += ' (offen)';
            }
            opt.textContent = displayText;
            // Add data attributes for per-event role and team alias
            opt.setAttribute('data-user-role', eventRole);
            opt.setAttribute('data-team-alias', teamAlias);
            if (name === selectedSpieltag) opt.selected = true;
            refs.select.appendChild(opt);
        }
        refs.select.disabled = spieltage.length === 0;
    },
    getInitialSpieltag: function() {
        var preferredSpieltag = getCurrentBookingSpieltag();
        return syncTeamStatsSpieltagSelect(preferredSpieltag);
    }
});

function openTeamStatsModal() {
    return teamStatsModalController.open();
}

function loadTeamStatsForSpieltag(selectedSpieltag) {
    return teamStatsModalController.load(selectedSpieltag);
}

function closeTeamStatsModal() {
    teamStatsModalController.close();
}

function openDrinksSummaryModal() {
    var now = new Date();
    var fromDateObj = new Date(now.getTime() - 6 * 24 * 60 * 60 * 1000);
    var fromDate = fromDateObj.toISOString().slice(0, 10);
    // Open summary with explicit quick range and mode so UI reflects state immediately
    var summaryUrl = './drinks-summary?quick=sinceLastCheck&mode=count';
    document.getElementById('drinksSummaryModal').style.display = 'flex';
    document.getElementById('drinksSummaryFrame').src = summaryUrl;
    // Reset logout timer to 30 minutes if in simple order mode
    if (window.SIMPLE_ORDER_MODE && typeof localStorage !== 'undefined') {
        var deadlineKey = 'simpleOrderLogoutDeadline';
        var LOGOUT_DELAY = 30 * 60 * 1000; // 30 minutes
        var deadline = Date.now() + LOGOUT_DELAY;
        localStorage.setItem(deadlineKey, deadline);
        if (typeof startLogoutTimer === 'function') {
            startLogoutTimer();
        }
    }
}
function closeDrinksSummaryModal() {
    document.getElementById('drinksSummaryModal').style.display = 'none';
    document.getElementById('drinksSummaryFrame').src = '';
}
</script>
</body>
