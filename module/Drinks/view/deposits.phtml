$pageUsers = [];
foreach ($this->users as $user) {
    if (in_array($user->get('status'), ['enabled', 'admin', 'assist'], true)) {
        // drinks fields are filled per user from get-user-deposits-data
        $pageUsers[] = ['uid' => (string)(int)$user->get('uid'), 'alias' => (string)$user->get('alias'), 'email' => (string)$user->get('email'),
            'drinks_enabled' => 0, 'drinks_alias' => '', 'teamlead_email' => '', 'is_team' => 0];
    }
}
$pageDrinks = [];
foreach ($this->drinks as $drink) {
    if ((int)$drink['id'] !== -1) { // -1 is the money transfer pseudo-drink
        $pageDrinks[] = ['id' => (int)$drink['id'], 'name' => $drink['name'] ?? '', 'price' => (float)$drink['price']];
    }
}
echo $this->partial('drinks-script', [
    'src' => 'drinks/deposits-page.js',
    'data' => ['DEPOSITS_PAGE' => [
        'urls' => [
            'user/add-drink-booking' => $this->url('user/add-drink-booking'),
            'user/create-team-event' => $this->url('user/create-team-event'),
            'user/get-user-deposits-data' => $this->url('user/get-user-deposits-data'),
