<script>
(function(){
    var button = document.getElementById('paypal-fetch-button');
    var historyButton = document.getElementById('paypal-history-button');
    var emailsImportButton = document.getElementById('emails-import-button');
    var status = document.getElementById('paypal-fetch-status');
    var filterForm = document.getElementById('deposit-overview-filter-form');
    var quickRangeInput = document.getElementById('deposit-quick-range');
    var fromFilterInput = document.getElementById('deposit-from-date');
    var toFilterInput = document.getElementById('deposit-to-date');
    var rangeModalOpenButton = document.getElementById('deposit-range-modal-open');
    var rangeSummary = document.getElementById('deposit-range-summary');
    var rangeModal = document.getElementById('deposit-range-modal');
    var rangeModalFromInput = document.getElementById('deposit-modal-date-from');
    var rangeModalToInput = document.getElementById('deposit-modal-date-to');
    var rangeModalSubmitButton = document.getElementById('deposit-range-submit');
    var rangeModalCancelButton = document.getElementById('deposit-range-cancel');
    var rangeBackButton = document.getElementById('deposit-range-back');
    var rangeForwardButton = document.getElementById('deposit-range-forward');

    function formatDateValue(dateObj) {
        return dateObj.getFullYear() + '-'
            + String(dateObj.getMonth() + 1).padStart(2, '0') + '-'
            + String(dateObj.getDate()).padStart(2, '0');
    }

    function formatDateLabel(value) {
        if (!value) return '';
        var datePart = value.slice(0, 10);
        var parts = datePart.split('-');
        if (parts.length !== 3) return value;
        return parts[2] + '.' + parts[1] + '.' + parts[0];
    }

    function parseDateInputValue(value) {
        if (!value) return null;
        var parsed = new Date(value + 'T00:00:00');
        return isNaN(parsed.getTime()) ? null : parsed;
    }

    function updateRangeSummary() {
        if (!rangeSummary) return;
        if (!fromFilterInput.value && !toFilterInput.value) {
            rangeSummary.textContent = '<?= $this->t('kein Zeitraum gewählt') ?>';
            return;
        }
        rangeSummary.textContent = formatDateLabel(fromFilterInput.value) + ' - ' + formatDateLabel(toFilterInput.value);
    }

    function openRangeModal() {
        if (!rangeModal || !rangeModalFromInput || !rangeModalToInput) return;
        rangeModalFromInput.value = fromFilterInput.value ? fromFilterInput.value.slice(0, 10) : '';
        rangeModalToInput.value = toFilterInput.value ? toFilterInput.value.slice(0, 10) : '';
        rangeModal.style.display = 'flex';
    }

    function closeRangeModal() {
        if (rangeModal) {
            rangeModal.style.display = 'none';
        }
    }

    function adjustDepositRange(value) {
        if (!fromFilterInput || !toFilterInput) return;
        var now = new Date();
        var year = now.getFullYear();
        var month = now.getMonth();
        var fromValue = '';
        var toValue = '';

        if (value === 'l14d') {
            var startDate14 = new Date(now);
            startDate14.setDate(startDate14.getDate() - 13);
            fromValue = formatDateValue(startDate14);
            toValue = formatDateValue(now);
        } else if (value === 'l31d') {
            var startDate = new Date(now);
            startDate.setDate(startDate.getDate() - 30);
            fromValue = formatDateValue(startDate);
            toValue = formatDateValue(now);
        } else if (value === 'cw' || value === 'lw') {
            var monday = (function(d) {
                var copy = new Date(d);
                var day = copy.getDay();
                var diff = copy.getDate() - day + (day === 0 ? -6 : 1);
                copy.setDate(diff);
                return copy;
            })(now);
            if (value === 'lw') {
                monday.setDate(monday.getDate() - 7);
            }
            var sunday = new Date(monday);
            sunday.setDate(monday.getDate() + 6);
            fromValue = formatDateValue(monday);
            toValue = formatDateValue(sunday);
        } else if (value === 'cm' || value === 'lm') {
            var targetMonth = (value === 'cm') ? month : (month === 0 ? 11 : month - 1);
            var targetYear = (value === 'cm') ? year : (month === 0 ? year - 1 : year);
            var firstDay = new Date(targetYear, targetMonth, 1, 0, 0, 0);
            var lastDay = new Date(targetYear, targetMonth + 1, 0, 23, 59, 59);
            fromValue = formatDateValue(firstDay);
            toValue = formatDateValue(lastDay);
        } else if (value === 'cy' || value === 'ly') {
            var targetYearOnly = value === 'cy' ? year : year - 1;
            var firstYearDay = new Date(targetYearOnly, 0, 1, 0, 0, 0);
            var lastYearDay = new Date(targetYearOnly, 11, 31, 23, 59, 59);
            fromValue = formatDateValue(firstYearDay);
            toValue = formatDateValue(lastYearDay);
        }

        fromFilterInput.value = fromValue;
        toFilterInput.value = toValue;
        updateRangeSummary();
    }

    function shiftRange(direction) {
        if (!filterForm || !fromFilterInput || !toFilterInput) return;
        var fromDate = parseDateInputValue(fromFilterInput.value);
        var toDate = parseDateInputValue(toFilterInput.value);
        if (!fromDate || !toDate) return;

        var quickValue = quickRangeInput ? quickRangeInput.value : '';
        var newFrom = new Date(fromDate);
        var newTo = new Date(toDate);

        if (quickValue === 'cw' || quickValue === 'lw') {
            newFrom.setDate(newFrom.getDate() + (7 * direction));
            newTo.setDate(newTo.getDate() + (7 * direction));
        } else if (quickValue === 'cm' || quickValue === 'lm') {
            newFrom = new Date(newFrom.getFullYear(), newFrom.getMonth() + direction, 1, 0, 0, 0);
            newTo = new Date(newFrom.getFullYear(), newFrom.getMonth() + 1, 0, 23, 59, 0);
        } else if (quickValue === 'cy' || quickValue === 'ly') {
            newFrom = new Date(newFrom.getFullYear() + direction, 0, 1, 0, 0, 0);
            newTo = new Date(newFrom.getFullYear(), 11, 31, 23, 59, 0);
        } else if (quickValue === 'l14d') {
            newFrom.setDate(newFrom.getDate() + (14 * direction));
            newTo.setDate(newTo.getDate() + (14 * direction));
        } else if (quickValue === 'l31d') {
            newFrom.setDate(newFrom.getDate() + (31 * direction));
            newTo.setDate(newTo.getDate() + (31 * direction));
        } else {
            var dayMs = 24 * 60 * 60 * 1000;
            var fromDay = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate());
            var toDay = new Date(toDate.getFullYear(), toDate.getMonth(), toDate.getDate());
            var spanDays = Math.round((toDay.getTime() - fromDay.getTime()) / dayMs) + 1;
            newFrom.setDate(newFrom.getDate() + (spanDays * direction));
            newTo.setDate(newTo.getDate() + (spanDays * direction));
        }

        fromFilterInput.value = formatDateValue(newFrom);
        toFilterInput.value = formatDateValue(newTo);
        updateRangeSummary();
        filterForm.submit();
    }

    // Restore status message after page reload
    (function() {
        if (!status) return;
        var savedMsg = sessionStorage.getItem('paypalStatusMessage');
        if (savedMsg) {
            status.style.color = sessionStorage.getItem('paypalStatusColor') || '#155724';
            status.textContent = savedMsg;
            sessionStorage.removeItem('paypalStatusMessage');
            sessionStorage.removeItem('paypalStatusColor');
        }
    })();

    function doPaypalPost(url, loadingText) {
        [button, historyButton, emailsImportButton].forEach(function(b) { if (b) b.disabled = true; });
        if (status) {
            status.style.color = '#444';
            status.textContent = loadingText;
        }
        var xhr = new XMLHttpRequest();
        xhr.open('POST', url, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function() {
            if (xhr.readyState !== 4) return;
            [button, historyButton, emailsImportButton].forEach(function(b) { if (b) b.disabled = false; });
            try {
                var data = JSON.parse(xhr.responseText);
                if (xhr.status === 200 && data.success) {
                    if (status) {
                        status.style.color = '#155724';
                        status.textContent = data.message || '<?= $this->t('Erfolgreich.') ?>';
                    }
                    sessionStorage.setItem('paypalStatusMessage', data.message || '<?= $this->t('Erfolgreich.') ?>');
                    sessionStorage.setItem('paypalStatusColor', '#155724');
                    setTimeout(function() { location.reload(); }, 1200);
                } else {
                    if (status) {
                        status.style.color = '#721c24';
                        status.textContent = data.error || '<?= $this->t('Fehler.') ?>';
                    }
                }
            } catch (e) {
                if (status) {
                    status.style.color = '#721c24';
                    status.textContent = '<?= $this->t('Unerwartete Antwort vom Server.') ?>';
                }
            }
        };
        xhr.send('');
    }

    if (button) {
        button.addEventListener('click', function() {
            doPaypalPost('<?= $this->url('user/paypal-fetch') ?>', '<?= $this->t('PayPal-Abruf wird gestartet...') ?>');
        });
    }
    if (historyButton) {
        historyButton.addEventListener('click', function() {
            var today = new Date();
            var thirtyDaysAgo = new Date(today);
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            document.getElementById('history-date-from').value = thirtyDaysAgo.toISOString().split('T')[0];
            document.getElementById('history-date-to').value = today.toISOString().split('T')[0];
            document.getElementById('paypal-history-modal').style.display = 'flex';
        });
        document.getElementById('history-cancel').addEventListener('click', function() {
            document.getElementById('paypal-history-modal').style.display = 'none';
        });
        document.getElementById('history-submit').addEventListener('click', function() {
            var fromDate = document.getElementById('history-date-from').value;
            var toDate = document.getElementById('history-date-to').value;
            if (!fromDate || !toDate) {
                alert('<?= $this->t('Bitte Datum eingeben') ?>');
                return;
            }
            if (fromDate > toDate) {
                alert('<?= $this->t('Von-Datum muss vor Bis-Datum liegen') ?>');
                return;
            }
            document.getElementById('paypal-history-modal').style.display = 'none';
            doPaypalPost('<?= $this->url('user/paypal-history-import') ?>?from=' + encodeURIComponent(fromDate) + '&to=' + encodeURIComponent(toDate), '<?= $this->t('Historie wird importiert...') ?>');
        });
        document.getElementById('paypal-history-modal').addEventListener('click', function(e) {
            if (e.target === this) document.getElementById('paypal-history-modal').style.display = 'none';
        });
    }

    if (emailsImportButton) {
        emailsImportButton.addEventListener('click', function() {
            var today = new Date();
            var thirtyDaysAgo = new Date(today);
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            document.getElementById('emails-import-date-from').value = thirtyDaysAgo.toISOString().split('T')[0];
            document.getElementById('emails-import-date-to').value = today.toISOString().split('T')[0];
            document.getElementById('emails-import-modal').style.display = 'flex';
        });
        document.getElementById('emails-import-cancel').addEventListener('click', function() {
            document.getElementById('emails-import-modal').style.display = 'none';
        });
        document.getElementById('emails-import-submit').addEventListener('click', function() {
            var fromDate = document.getElementById('emails-import-date-from').value;
            var toDate = document.getElementById('emails-import-date-to').value;
            if (!fromDate || !toDate) {
                alert('<?= $this->t('Bitte Datum eingeben') ?>');
                return;
            }
            if (fromDate > toDate) {
                alert('<?= $this->t('Von-Datum muss vor Bis-Datum liegen') ?>');
                return;
            }
            document.getElementById('emails-import-modal').style.display = 'none';
            doPaypalPost('<?= $this->url('user/emails-import') ?>?from=' + encodeURIComponent(fromDate) + '&to=' + encodeURIComponent(toDate), '<?= $this->t('E-Mails werden durchsucht...') ?>');
        });
        document.getElementById('emails-import-modal').addEventListener('click', function(e) {
            if (e.target === this) document.getElementById('emails-import-modal').style.display = 'none';
        });
    }

    // Unassigned PayPal filter
    var unassignedCb = document.getElementById('show-unassigned-paypal-checkbox');
    if (unassignedCb) {
        function applyPaypalFilter() {
            var onlyUnassigned = unassignedCb.checked;
            var rows = document.querySelectorAll('tbody tr[data-paypal-unassigned]');
            var allRows = document.querySelectorAll('tbody tr');
            allRows.forEach(function(r) {
                if (!onlyUnassigned) {
                    r.style.display = '';
                } else {
                    var isUnassigned = r.getAttribute('data-paypal-unassigned') === '1';
                    var state = r.getAttribute('data-paypal-state');
                    var isNotIgnored = state !== 'ignored';
                    r.style.display = (isUnassigned && isNotIgnored) ? '' : 'none';
                }
            });
        }
        unassignedCb.addEventListener('change', applyPaypalFilter);
    }

    if (quickRangeInput && filterForm) {
        quickRangeInput.addEventListener('change', function() {
            adjustDepositRange(quickRangeInput.value);
            filterForm.submit();
        });
    }

    if (rangeModalOpenButton) {
        rangeModalOpenButton.addEventListener('click', openRangeModal);
    }

    if (rangeModalCancelButton) {
        rangeModalCancelButton.addEventListener('click', closeRangeModal);
    }

    if (rangeModalSubmitButton && rangeModalFromInput && rangeModalToInput) {
        rangeModalSubmitButton.addEventListener('click', function() {
            var fromValue = rangeModalFromInput.value;
            var toValue = rangeModalToInput.value;
            if (!fromValue || !toValue) {
                alert('<?= $this->t('Bitte Datum eingeben') ?>');
                return;
            }
            if (fromValue > toValue) {
                alert('<?= $this->t('Von-Datum muss vor Bis-Datum liegen') ?>');
                return;
            }
            fromFilterInput.value = fromValue;
            toFilterInput.value = toValue;
            updateRangeSummary();
            if (quickRangeInput && quickRangeInput.value !== '') {
                quickRangeInput.value = '';
            }
            closeRangeModal();
            filterForm.submit();
        });
    }

    if (rangeModal) {
        rangeModal.addEventListener('click', function(e) {
            if (e.target === rangeModal) {
                closeRangeModal();
            }
        });
    }

    if (rangeBackButton) {
        rangeBackButton.addEventListener('click', function() {
            shiftRange(-1);
        });
    }

    if (rangeForwardButton) {
        rangeForwardButton.addEventListener('click', function() {
            shiftRange(1);
        });
    }

    updateRangeSummary();
})();
</script>

