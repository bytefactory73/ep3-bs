<script>
(function(){
    var button = document.getElementById('paypal-fetch-button');
    var historyButton = document.getElementById('paypal-history-button');
    var status = document.getElementById('paypal-fetch-status');

    // Restore status message after page reload
    (function() {
        var savedMsg = sessionStorage.getItem('paypalStatusMessage');
        if (savedMsg) {
            status.style.color = sessionStorage.getItem('paypalStatusColor') || '#155724';
            status.textContent = savedMsg;
            sessionStorage.removeItem('paypalStatusMessage');
            sessionStorage.removeItem('paypalStatusColor');
        }
    })();

    function doPaypalPost(url, loadingText) {
        [button, historyButton].forEach(function(b) { if (b) b.disabled = true; });
        status.style.color = '#444';
        status.textContent = loadingText;
        var xhr = new XMLHttpRequest();
        xhr.open('POST', url, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function() {
            if (xhr.readyState !== 4) return;
            [button, historyButton].forEach(function(b) { if (b) b.disabled = false; });
            try {
                var data = JSON.parse(xhr.responseText);
                if (xhr.status === 200 && data.success) {
                    status.style.color = '#155724';
                    status.textContent = data.message || '<?= $this->t('Erfolgreich.') ?>';
                    sessionStorage.setItem('paypalStatusMessage', data.message || '<?= $this->t('Erfolgreich.') ?>');
                    sessionStorage.setItem('paypalStatusColor', '#155724');
                    setTimeout(function() { location.reload(); }, 1200);
                } else {
                    status.style.color = '#721c24';
                    status.textContent = data.error || '<?= $this->t('Fehler.') ?>';
                }
            } catch (e) {
                status.style.color = '#721c24';
                status.textContent = '<?= $this->t('Unerwartete Antwort vom Server.') ?>';
            }
        };
        xhr.send('');
    }

    if (button) {
        button.addEventListener('click', function() {
            doPaypalPost('<?= $this->url('user/paypal-fetch') ?>', '<?= $this->t('PayPal-Abruf wird gestartet...') ?>');
        });
    }
    if (historyButton) {
        historyButton.addEventListener('click', function() {
            var today = new Date();
            var thirtyDaysAgo = new Date(today);
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            document.getElementById('history-date-from').value = thirtyDaysAgo.toISOString().split('T')[0];
            document.getElementById('history-date-to').value = today.toISOString().split('T')[0];
            document.getElementById('paypal-history-modal').style.display = 'flex';
        });
        document.getElementById('history-cancel').addEventListener('click', function() {
            document.getElementById('paypal-history-modal').style.display = 'none';
        });
        document.getElementById('history-submit').addEventListener('click', function() {
            var fromDate = document.getElementById('history-date-from').value;
            var toDate = document.getElementById('history-date-to').value;
            if (!fromDate || !toDate) {
                alert('<?= $this->t('Bitte Datum eingeben') ?>');
                return;
            }
            if (fromDate > toDate) {
                alert('<?= $this->t('Von-Datum muss vor Bis-Datum liegen') ?>');
                return;
            }
            document.getElementById('paypal-history-modal').style.display = 'none';
            doPaypalPost('<?= $this->url('user/paypal-history-import') ?>?from=' + encodeURIComponent(fromDate) + '&to=' + encodeURIComponent(toDate), '<?= $this->t('Historie wird importiert...') ?>');
        });
        document.getElementById('paypal-history-modal').addEventListener('click', function(e) {
            if (e.target === this) document.getElementById('paypal-history-modal').style.display = 'none';
        });
    }

    // Unassigned PayPal filter
    var unassignedCb = document.getElementById('show-unassigned-paypal-checkbox');
    if (unassignedCb) {
        function applyPaypalFilter() {
            var onlyUnassigned = unassignedCb.checked;
            var rows = document.querySelectorAll('tbody tr[data-paypal-unassigned]');
            var allRows = document.querySelectorAll('tbody tr');
            allRows.forEach(function(r) {
                if (!onlyUnassigned) {
                    r.style.display = '';
                } else {
                    var isUnassigned = r.getAttribute('data-paypal-unassigned') === '1';
                    var state = r.getAttribute('data-paypal-state');
                    var isNotIgnored = state !== 'ignored';
                    r.style.display = (isUnassigned && isNotIgnored) ? '' : 'none';
                }
            });
        }
        unassignedCb.addEventListener('change', applyPaypalFilter);
    }
})();
</script>

