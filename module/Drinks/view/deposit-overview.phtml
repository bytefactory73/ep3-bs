<script>
(function() {
    var users = <?php
        $usersArr = [];
        foreach ($this->allUsers as $_uid => $_udata) {
            $usersArr[] = [
                'uid' => (int)$_uid,
                'name' => isset($_udata['display']) ? $_udata['display'] : '',
                'email' => isset($_udata['email']) ? $_udata['email'] : '',
            ];
        }
        echo json_encode($usersArr, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    ?>;

    var modal = document.getElementById('paypal-reassign-modal');
    var searchInput = document.getElementById('paypal-reassign-search');
    var listEl = document.getElementById('paypal-reassign-list');
    var statusEl = document.getElementById('paypal-reassign-status');
    var infoEl = document.getElementById('paypal-reassign-info');
    var currentPaypalId = null;
    var currentPreferredIds = [];

    function renderList(filter, preferredIds) {
        listEl.innerHTML = '';
        var f = (filter || '').toLowerCase().trim();
        preferredIds = preferredIds || [];
        var shown = 0;
        var preferredShown = 0;

        function matches(u) {
            var label = u.name + (u.email ? ' (' + u.email + ')' : '');
            return !f || label.toLowerCase().indexOf(f) !== -1;
        }

        function appendUser(u, isPreferred) {
            if (!matches(u)) return;
            shown++;
            if (isPreferred) {
                preferredShown++;
            }
            var label = u.name + (u.email ? ' (' + u.email + ')' : '');
            var item = document.createElement('div');
            item.style.cssText = isPreferred
                ? 'padding:8px 12px; cursor:pointer; border-bottom:1px solid #d4e6f5; background:#eef7ff; color:#1769aa; font-weight:bold; font-size:0.95em;'
                : 'padding:8px 12px; cursor:pointer; border-bottom:1px solid #eee; font-size:0.95em;';
            item.textContent = label;
            item.addEventListener('mouseenter', function() { item.style.background = '#e3f0fa'; });
            item.addEventListener('mouseleave', function() { item.style.background = isPreferred ? '#eef7ff' : ''; });
            item.addEventListener('click', function() { doReassign(u.uid, label); });
            listEl.appendChild(item);
        }

        var preferredUsers = [];
        var otherUsers = [];
        users.forEach(function(u) {
            if (preferredIds.indexOf(u.uid) !== -1) {
                preferredUsers.push(u);
            } else {
                otherUsers.push(u);
            }
        });
        preferredUsers.forEach(function(u) { appendUser(u, true); });
        otherUsers.forEach(function(u) { appendUser(u, false); });
        if (shown === 0) {
            var empty = document.createElement('div');
            empty.style.cssText = 'padding:10px 12px; color:#888; font-size:0.9em;';
            empty.textContent = 'Kein Benutzer gefunden.';
            listEl.appendChild(empty);
        }
    }

    function doReassign(userId, userName) {
        statusEl.style.color = '#555';
        statusEl.textContent = 'Wird gespeichert...';
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?= $this->url('user/reassign-paypal-transaction') ?>', true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function() {
            if (xhr.readyState !== 4) return;
            try {
                var data = JSON.parse(xhr.responseText);
                if (xhr.status === 200 && data.success) {
                    statusEl.style.color = '#19692b';
                    var msg = 'Zugeordnet an: ' + userName;
                    if (data.deposit_linked) {
                        msg += ' — Buchung automatisch verknüpft.';
                    }
                    statusEl.textContent = msg;
                    setTimeout(function() { location.reload(); }, 900);
                } else {
                    statusEl.style.color = '#721c24';
                    statusEl.textContent = data.error || 'Fehler beim Speichern.';
                }
            } catch(e) {
                statusEl.style.color = '#721c24';
                statusEl.textContent = 'Unerwartete Antwort.';
            }
        };
        xhr.send('paypal_id=' + encodeURIComponent(currentPaypalId) + '&user_id=' + encodeURIComponent(userId));
    }

    function openModal(paypalId, payerEmail, paypalNote, preferredIds) {
        currentPaypalId = paypalId;
        currentPreferredIds = preferredIds || [];
        var infoText = payerEmail ? ('PayPal E-Mail: ' + payerEmail) : 'Keine E-Mail bekannt';
        if (paypalNote && paypalNote.trim() !== '') {
            infoText += '\nNotiz: ' + paypalNote.trim();
        }
        infoEl.style.whiteSpace = 'pre-line';
        infoEl.textContent = infoText;
        searchInput.value = '';
        statusEl.textContent = '';
        renderList('', currentPreferredIds);
        modal.style.display = 'flex';
        setTimeout(function() { searchInput.focus(); }, 80);
    }

    document.addEventListener('click', function(e) {
        var badge = e.target.closest ? e.target.closest('.paypal-badge') : null;
        if (!badge) {
            if (e.target === modal) closeModal();
            return;
        }
        var preferredIds = [];
        try {
            preferredIds = JSON.parse(badge.getAttribute('data-paypal-match-user-ids') || '[]').map(Number);
        } catch (e) {}
        openModal(badge.getAttribute('data-paypal-id'), badge.getAttribute('data-paypal-email'), badge.getAttribute('data-paypal-note'), preferredIds);
    });

    searchInput.addEventListener('input', function() { renderList(searchInput.value, currentPreferredIds); });

    function closeModal() {
        modal.style.display = 'none';
        currentPaypalId = null;
        currentPreferredIds = [];
    }

    function createDepositFromPaypal(paypalId, userId, trigger) {
        if (!paypalId || !userId) return;
        if (!window.confirm('Einzahlung aus dieser PayPal-Transaktion anlegen?')) return;
        trigger.disabled = true;
        trigger.style.opacity = '0.6';
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?= $this->url('user/create-deposit-from-paypal') ?>', true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function() {
            if (xhr.readyState !== 4) return;
            try {
                var data = JSON.parse(xhr.responseText);
                if (xhr.status === 200 && data.success) {
                    location.reload();
                } else {
                    trigger.disabled = false;
                    trigger.style.opacity = '';
                    alert(data.error || 'Fehler beim Gutschreiben der Einzahlung.');
                }
            } catch (e) {
                trigger.disabled = false;
                trigger.style.opacity = '';
                alert('Unerwartete Antwort vom Server.');
            }
        };
        xhr.send('paypal_id=' + encodeURIComponent(paypalId) + '&user_id=' + encodeURIComponent(userId));
    }

    document.getElementById('paypal-reassign-close-x').addEventListener('click', closeModal);
    document.getElementById('paypal-reassign-cancel').addEventListener('click', closeModal);
    modal.addEventListener('mousedown', function(e) { if (e.target === modal) closeModal(); });

    // Ignore PayPal button
    document.addEventListener('click', function(e) {
        var btn = e.target.closest ? e.target.closest('.paypal-ignore-btn') : null;
        if (!btn) return;
        var paypalId = btn.getAttribute('data-paypal-id');
        if (!paypalId) return;
        btn.disabled = true;
        btn.textContent = '...';
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?= $this->url('user/ignore-paypal-transaction') ?>', true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function() {
            if (xhr.readyState !== 4) return;
            try {
                var data = JSON.parse(xhr.responseText);
                if (xhr.status === 200 && data.success) {
                    location.reload();
                } else {
                    btn.disabled = false;
                    btn.textContent = '<?= $this->t('Ignorieren') ?>';
                }
            } catch (e) {
                btn.disabled = false;
                btn.textContent = '<?= $this->t('Ignorieren') ?>';
            }
        };
        xhr.send('paypal_id=' + encodeURIComponent(paypalId));
    });

    // Deposit anlegen buttons — AJAX instead of form POST
    document.addEventListener('click', function(e) {
        var btn = e.target.closest ? e.target.closest('.deposit-anlegen-btn') : null;
        if (!btn) return;
        createDepositFromPaypal(btn.getAttribute('data-paypal-id'), btn.getAttribute('data-user-id'), btn);
    });
})();
</script>
