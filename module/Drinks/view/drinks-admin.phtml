    <script>
    (function(){
        var checkbox = document.querySelector('input[name="party_mode_enabled"]');
        if(!checkbox) return;
                var fields = [
                    document.getElementById('party-mode-start'),
                    document.getElementById('party-mode-end'),
                    document.getElementById('party-mode-message')
                ];
                function sync(){
                    var en = checkbox.checked;
                    fields.forEach(function(f){
                        if(!f) return;
                        if(en){
                            f.removeAttribute('readonly');
                            f.classList.remove('pm-readonly');
                        } else {
                            f.setAttribute('readonly','readonly');
                            f.classList.add('pm-readonly');
                        }
                    });
                }
        checkbox.addEventListener('change', sync);
        sync();
    })();
    </script>
        <style>
            .pm-readonly { background:#f5f5f5 !important; color:#555; }
            .pm-readonly:focus { outline:none; }
        </style>

