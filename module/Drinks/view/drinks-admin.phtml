                    <input type="datetime-local" id="party-mode-start" name="party_mode_start" value="<?= $this->escapeHtmlAttr($partyModeStartLocal) ?>" style="width:100%; box-sizing:border-box; padding:6px 8px;" <?= $partyModeEnabled ? '' : 'readonly' ?>>
                    <div class="small gray" style="font-size:0.78em; margin-top:2px;">Aktiv erst ab diesem Zeitpunkt</div>
                </div>
                <div style="flex:1 1 240px; min-width:220px;">
                    <label for="party-mode-end" style="font-weight:bold; display:block; margin:0 0 4px;">Ende (optional)</label>
                    <input type="datetime-local" id="party-mode-end" name="party_mode_end" value="<?= $this->escapeHtmlAttr($partyModeEndLocal) ?>" style="width:100%; box-sizing:border-box; padding:6px 8px;" <?= $partyModeEnabled ? '' : 'readonly' ?>>
                    <div class="small gray" style="font-size:0.78em; margin-top:2px;">Automatisch deaktivieren danach</div>
                </div>
            </div>
            <div style="margin:8px 0;">
                <label for="party-mode-message" style="font-weight:bold; display:block; margin-bottom:4px;">Nachricht (wird Benutzern angezeigt)</label>
                <textarea id="party-mode-message" name="party_mode_message" rows="3" style="width:100%; box-sizing:border-box;" <?= $partyModeEnabled ? '' : 'readonly' ?>><?= $this->escapeHtml($partyModeMessage) ?></textarea>
            </div>
