    <label style="display:inline-flex; align-items:center; gap:6px; margin-top:14px; cursor:pointer; font-size:0.95em; color:#445;">
        <input type="checkbox" id="spieltage-only-open" style="cursor:pointer;">
        <?= $this->t('Nur offene Spieltage anzeigen') ?>
    </label>
    <div class="spieltage-overview-list" id="spieltage-overview-list">
        <?php foreach ($this->events as $event): ?>
            <?php
            $eventId    = (int)($event['id'] ?? 0);
            $label      = $this->escapeHtml($event['label'] ?? '');
            $teamAlias  = $this->escapeHtml($event['team_alias'] ?? '');
            $teamUid    = (int)($event['team_user_id'] ?? 0);
            $closed     = !empty($event['closed']);
            $balance    = (float)($event['balance'] ?? 0);
            $badges     = $event['badges'] ?? [];
            $statusLabel = $closed ? 'abgeschlossen' : 'offen';
            $balanceColor = $balance >= 0 ? '#2e7d32' : '#c62828';
            $balanceFormatted = number_format($balance, 2, ',', '.') . ' €';
            ?>
            <button
                type="button"
                class="spieltage-overview-item"
                data-event-id="<?= $eventId ?>"
                data-team-uid="<?= $teamUid ?>"
                data-closed="<?= $closed ? '1' : '0' ?>"
            >
                <span>
                    <span class="event-team"><?= $teamAlias ?> &middot;</span>
                    <strong><?= $label ?></strong>
                    <span class="event-status">(<?= $statusLabel ?>)</span>
                </span>
                <span style="display:flex; align-items:center; gap:10px; white-space:nowrap;">
                    <?php foreach ($badges as $badge): ?>
                        <span style="font-size:0.9em; color:#555;"><?= (int)$badge['qty'] ?>x<?= $badge['emoji'] ?></span>
                    <?php endforeach; ?>
