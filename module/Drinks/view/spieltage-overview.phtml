        </div>
        <div id="spieltageTeamEventStatsContent" style="padding:2px 4px 8px 4px;"></div>
    </div>
</div>

<script>
(function() {
    function closeSpieltageModal() {
        var modal = document.getElementById('spieltageTeamEventStatsModal');
        if (modal) {
            modal.style.display = 'none';
        }
    }
    window.closeSpieltageModal = closeSpieltageModal;

    var statsModalController = null;

    if (typeof createTeamStatsModal === 'function') {
        statsModalController = createTeamStatsModal({
            modalId: 'spieltageTeamEventStatsModal',
            contentId: 'spieltageTeamEventStatsContent',
            balanceHeaderId: 'spieltage-team-event-stats-balance-header',
            selectId: 'spieltage-team-event-stats-select',
            titleId: 'spieltage-team-event-stats-title',
            getTitle: function(teamAlias) {
                var alias = String(teamAlias || '').trim();
                return alias ? ('Kostenübersicht - ' + alias) : 'Kostenübersicht';
            },
            onOpen: function(args, state) {
                var uid = parseInt(args[0] || 0, 10);
                var teamEventId = String(args[1] || '');
                if (uid > 0) {
                    state.teamUid = uid;
                }
                state.preferredTeamEventId = teamEventId;
                state.teamAlias = String(args[2] || '');
            },
            getInitialSpieltag: function(args, state) {
                return String(state.preferredTeamEventId || '');
            },
            buildStatsUrl: function(spieltag, state) {
                var uid = parseInt(state.teamUid || 0, 10);
                if (!uid) {
                    throw new Error('Ungültiger Team-Account.');
                }
                var url = '<?= $this->url('user/get-user-team-event-stats-data') ?>?uid=' + encodeURIComponent(String(uid));
                var teamEventId = String(spieltag || state.preferredTeamEventId || '').trim();
                if (teamEventId !== '') {
                    url += '&team_event_id=' + encodeURIComponent(teamEventId);
                }
                return url;
            },
            buildMemberUpdateRequest: function(operation, memberUserId, state) {
                return {
                    url: '<?= $this->url('user/teamlead-team-members') ?>',
                    body: new URLSearchParams({
                        operation: String(operation || ''),
                        team_event_id: String(state.currentEventId || 0),
                        member_user_id: String(memberUserId || 0)
                    })
                };
            },
            buildCloseEventRequest: function(state, settlement) {
                var body = new URLSearchParams({
                    team_event_id: String(state.currentEventId || 0)
                });
                if (settlement && Array.isArray(settlement.refunds) && settlement.refunds.length > 0) {
                    body.set('settlement_refunds', JSON.stringify(settlement.refunds));
                }
                return {
                    url: '<?= $this->url('user/teamlead-close-team-event') ?>',
                    body: body
                };
            },
            afterLoadData: function(data, state, refs) {
                state.preferredTeamEventId = String(data.team_event_id || '');
                if (!refs.select) return;

                while (refs.select.firstChild) {
                    refs.select.removeChild(refs.select.firstChild);
                }

                var teamEvents = Array.isArray(data.team_events) ? data.team_events : [];
                for (var i = 0; i < teamEvents.length; i++) {
                    var eventRow = teamEvents[i] || {};
                    var eventId = String(eventRow.id || '').trim();
                    var label = String(eventRow.label || '').trim();
                    if (!eventId || !label) continue;
                    var option = document.createElement('option');
                    option.value = eventId;
                    option.textContent = label + (eventRow.closed ? ' (abgeschlossen)' : ' (offen)');
                    refs.select.appendChild(option);
                }

                if (state.preferredTeamEventId) {
                    refs.select.value = state.preferredTeamEventId;
                }
            }
        });
    }

    var list = document.getElementById('spieltage-overview-list');
    var onlyOpenCheckbox = document.getElementById('spieltage-only-open');

    function applyFilter() {
        if (!list) return;
        var onlyOpen = onlyOpenCheckbox && onlyOpenCheckbox.checked;
        list.querySelectorAll('.spieltage-overview-item').forEach(function(btn) {
            var closed = btn.getAttribute('data-closed') === '1';
            btn.style.display = (onlyOpen && closed) ? 'none' : '';
        });
    }

    if (onlyOpenCheckbox) {
        onlyOpenCheckbox.addEventListener('change', applyFilter);
    }

    if (list) {
        list.addEventListener('click', function(e) {
            var btn = e.target.closest('.spieltage-overview-item');
            if (!btn) return;
            var teamUid = String(btn.getAttribute('data-team-uid') || '').trim();
            var eventId = String(btn.getAttribute('data-event-id') || '').trim();
            var teamAlias = String(btn.getAttribute('data-team-alias') || '').trim();
            if (!teamUid || !eventId) return;
            if (statsModalController && typeof statsModalController.open === 'function') {
                statsModalController.open(teamUid, eventId, teamAlias);
            }
        });
    }
})();
</script>
