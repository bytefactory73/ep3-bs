            <?= $this->t('Klicken Sie auf einen Spieltag, um die Auswertung im Popup zu öffnen.') ?>
        </div>
    </div>
<?php endif; ?>

<script>
(function() {
    var statsModalController = createAdminTeamStatsModal('spieltage-team-stats');

    var list = document.getElementById('spieltage-overview-list');
    var onlyOpenCheckbox = document.getElementById('spieltage-only-open');

    function applyFilter() {
        if (!list) return;
        var onlyOpen = onlyOpenCheckbox && onlyOpenCheckbox.checked;
        list.querySelectorAll('.spieltage-overview-item').forEach(function(btn) {
            var closed = btn.getAttribute('data-closed') === '1';
            btn.style.display = (onlyOpen && closed) ? 'none' : '';
        });
    }

    if (onlyOpenCheckbox) {
        onlyOpenCheckbox.addEventListener('change', applyFilter);
    }

    if (list) {
        list.addEventListener('click', function(e) {
            var btn = e.target.closest('.spieltage-overview-item');
            if (!btn) return;
            var teamUid = String(btn.getAttribute('data-team-uid') || '').trim();
            var eventId = String(btn.getAttribute('data-event-id') || '').trim();
            if (!teamUid || !eventId) return;
            statsModalController.open(teamUid, eventId);
        });
    }
})();
</script>
