<script src="<?= $this->basePath('js/team-stats-modal.js?v=20260510-6') ?>"></script>
<script>
window.__frontendTeamStatsTeamAlias = <?= json_encode($teamLeadTeamAlias, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
window.__frontendTeamStatsTeamUid = 0;

var frontendTeamStatsModalController = createTeamStatsModal({
    modalId: 'frontendTeamStatsModal',
    contentId: 'frontendTeamStatsContent',
    balanceHeaderId: 'frontend-team-stats-account-balance-header',
    selectId: 'frontend-team-stats-spieltag-select',
    titleId: 'frontend-team-stats-title',
    initialTeamAlias: window.__frontendTeamStatsTeamAlias,
    memberInputId: 'frontend-team-stats-member-search',
    memberListId: 'frontend-team-stats-member-list',
    memberAddBtnId: 'frontend-team-stats-member-add',
    memberClearBtnId: 'frontend-team-stats-member-clear',
    rowClass: 'frontend-team-stats-member-row',
    removeButtonClass: 'frontend-team-stats-member-remove',
    addDirectButtonClass: 'frontend-team-stats-member-add-direct',
    manageContainerStyle: 'position:relative; display:flex; align-items:center; gap:6px; margin-top:10px; max-width:560px;',
    getTitle: function(teamAlias) {
        var alias = String(teamAlias || '').trim();
        return alias ? ('Kostenübersicht - ' + alias) : 'Kostenübersicht';
    },
    onOpen: function(args, state) {
        var uid = parseInt(args[0] || 0, 10);
        if (uid > 0) {
            state.teamUid = uid;
        }
    },
    buildStatsUrl: function(spieltag, state) {
        if (!state.teamUid) {
            throw new Error('Ungueltiger Team-Account.');
        }
        var url = '<?= $this->url('user/teamlead-team-stats') ?>?team_uid=' + encodeURIComponent(String(state.teamUid));
        if (spieltag) {
            url += '&spieltag=' + encodeURIComponent(spieltag);
        }
        return url;
    },
    buildMemberUpdateRequest: function(operation, memberUserId, state) {
        return {
            url: '<?= $this->url('user/teamlead-team-members') ?>',
            body: new URLSearchParams({
                operation: operation,
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                member_user_id: String(memberUserId)
            })
        };
    },
    buildOrderRelevanceUpdateRequest: function(drinkId, unitPrice, memberUserIds, state) {
        return {
            url: '<?= $this->url('user/teamlead-order-relevance') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                drink_id: String(drinkId),
                unit_price: String(unitPrice),
                member_user_ids: String((memberUserIds || []).join(','))
            })
        };
    },
    buildExtraCostCreateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-extra-cost') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                payer_user_id: String(payload.payerUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || ''),
                relevant_member_ids: String((payload.relevantMemberIds || []).join(','))
            })
        };
    },
    buildExtraCostUpdateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-update-extra-cost') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                extra_cost_id: String(payload.extraCostId || 0),
                team_event_id: String(state.currentEventId),
                payer_user_id: String(payload.payerUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || ''),
                relevant_member_ids: String((payload.relevantMemberIds || []).join(','))
            })
        };
    },
    buildExtraCostDeleteRequest: function(extraCostId, state) {
        return {
            url: '<?= $this->url('user/teamlead-delete-extra-cost') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                extra_cost_id: String(extraCostId || 0),
                team_event_id: String(state.currentEventId)
            })
        };
    },
    buildGuestDonationCreateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-guest-donation') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                receiver_user_id: String(payload.receiverUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || '')
            })
        };
    },
    buildGuestDonationUpdateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-update-guest-donation') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                guest_donation_id: String(payload.guestDonationId || 0),
                team_event_id: String(state.currentEventId),
                receiver_user_id: String(payload.receiverUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || '')
            })
        };
    },
    buildGuestDonationDeleteRequest: function(guestDonationId, state) {
        return {
            url: '<?= $this->url('user/teamlead-delete-guest-donation') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                guest_donation_id: String(guestDonationId || 0),
                team_event_id: String(state.currentEventId)
            })
        };
    },
    buildCloseEventRequest: function(state) {
        return {
            url: '<?= $this->url('user/teamlead-close-team-event') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId)
            })
        };
    },
    afterLoadData: function(data, state, refs) {
        if (data.team_alias) {
            state.teamAlias = String(data.team_alias);
        }
        if (refs.select) {
            while (refs.select.firstChild) {
                refs.select.removeChild(refs.select.firstChild);
            }
            var spieltage = Array.isArray(data.spieltage) ? data.spieltage : [];
            var openSpieltage = Array.isArray(data.open_spieltage) ? data.open_spieltage : [];
            var selectedSpieltag = data.spieltag || '';
            for (var i = 0; i < spieltage.length; i++) {
                var name = String(spieltage[i] || '').trim();
                if (!name) continue;
                var opt = document.createElement('option');
                opt.value = name;
                var isOpen = openSpieltage.indexOf(name) !== -1;
                opt.textContent = isOpen ? (name + ' (offen)') : name;
                if (name === selectedSpieltag) opt.selected = true;
                refs.select.appendChild(opt);
            }
            refs.select.disabled = spieltage.length === 0;
        }
    }
});

function openFrontendTeamStatsModal(teamUid) {
    return frontendTeamStatsModalController.open(teamUid);
}

function loadFrontendTeamStatsForSpieltag(spieltag) {
    return frontendTeamStatsModalController.load(spieltag);
}

function closeFrontendTeamStatsModal() {
    frontendTeamStatsModalController.close();
}
</script>
<?php endif; ?>