<?= $this->partial('team-stats-modal-script') ?>
<script>
// Teamleads manage the Spieltage of their teams; members see those they take part in, read-only.
var frontendTeamStatsModalController = createTeamStatsModal({
    id: 'frontend-team-stats',
    showRoleInTitle: true,
    endpoints: window.TEAM_STATS_URLS.endpoints,
    onOpen: function(args, state) {
        var teamLeadTeams = Array.isArray(args[0]) ? args[0] : [];
        state.teamUids = teamLeadTeams.map(function(team) { return String(team.user_id); });
        state.userUid = parseInt(args[2] || 0, 10);
        // Without a led team the user's own uid stands for the member view
        state.teamUid = state.teamUids.length ? state.teamUids[0] : String(state.userUid);
    },
    buildStatsUrl: function(teamEventId, state) {
        var query = { team_uid: state.teamUid, user_uid: state.userUid };
        if (state.teamUids.length) {
            query.team_uids = JSON.stringify(state.teamUids);
        } else {
            query.is_team_member = 1;
        }
        if (teamEventId) {
            query.team_event_id = teamEventId;
        }
        return window.TEAM_STATS_URLS.teamleadStats + '?' + new URLSearchParams(query).toString();
    }
});

function openFrontendTeamStatsModal(teamLeadTeams, isTeamMember, userUid) {
    return frontendTeamStatsModalController.open(teamLeadTeams, isTeamMember, userUid);
}
</script>
