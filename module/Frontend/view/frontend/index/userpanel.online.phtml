</div>
<script src="<?= $this->basePath('js/team-stats-modal.js?v=20260607-02') ?>"></script>
<script>
// Pass team data to JS for dropdown population
window.__frontendTeamStatsTeamAlias = <?= json_encode($primaryTeamAlias, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
window.__frontendTeamStatsTeamUid = <?= $primaryTeamUserId ?>;
window.__frontendTeamStatsTeamLeadTeams = <?= json_encode($teamLeadTeams, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
window.__frontendTeamStatsIsTeamMember = <?= $isTeamMember ? 'true' : 'false' ?>;
window.__frontendTeamStatsIsTeamLead = <?= ($teamLeadTeamUserId > 0) ? 'true' : 'false' ?>;
window.__frontendTeamStatsUserRole = <?= ($teamLeadTeamUserId > 0) ? "'Mannschaftsführer'" : (($isTeamMember) ? "'Teilnehmer'" : "''") ?>;

var frontendTeamStatsModalController = createTeamStatsModal({
    modalId: 'frontendTeamStatsModal',
    contentId: 'frontendTeamStatsContent',
    balanceHeaderId: 'frontend-team-stats-account-balance-header',
    selectId: 'frontend-team-stats-spieltag-select',
    titleId: 'frontend-team-stats-title',
    initialTeamAlias: window.__frontendTeamStatsTeamAlias,
    memberInputId: 'frontend-team-stats-member-search',
    memberListId: 'frontend-team-stats-member-list',
    memberAddBtnId: 'frontend-team-stats-member-add',
    memberClearBtnId: 'frontend-team-stats-member-clear',
    rowClass: 'frontend-team-stats-member-row',
    removeButtonClass: 'frontend-team-stats-member-remove',
    addDirectButtonClass: 'frontend-team-stats-member-add-direct',
    manageContainerStyle: 'position:relative; display:flex; align-items:center; gap:6px; margin-top:10px; max-width:560px;',
    getTitle: function(teamAlias, userRole) {
        var alias = String(teamAlias || '').trim();
        var role = String(userRole || '').trim();
        var roleSuffix = role ? (' - ' + role) : '';
        return alias ? ('Kostenübersicht - ' + alias + roleSuffix) : 'Kostenübersicht';
    },
    onOpen: function(args, state) {
        var teamLeadTeams = args[0] || [];
        var isTeamMember = args[1] === true;
        var userUid = parseInt(args[2] || 0, 10);
        // Store isTeamMember flag for buildStatsUrl
        state.isTeamMember = isTeamMember;
        // Store all teamLeadTeams for determining editability
        state.teamLeadTeams = (Array.isArray(teamLeadTeams) && teamLeadTeams.length > 0) ? teamLeadTeams : [];
        // Use teamLeadTeams array passed from button click
        if (state.teamLeadTeams.length > 0) {
            // Use first team as initial teamUid for the API query
            state.teamUid = state.teamLeadTeams[0].user_id;
        } else if (isTeamMember) {
            // For team members without teamlead role, use the user's personal UID
            // The API will find events where this user is a member
            state.teamUid = userUid;
        }
        // Store user's personal UID for member events query
        if (userUid > 0) {
            state.userUid = userUid;
        }
    },
    buildStatsUrl: function(spieltag, state) {
        if (!state.teamUid) {
            throw new Error('Ungueltiger Team-Account.');
        }
        var url = '<?= $this->url('user/teamlead-team-stats') ?>?team_uid=' + encodeURIComponent(String(state.teamUid));
        if (spieltag) {
            url += '&spieltag=' + encodeURIComponent(spieltag);
        }
        // Pass all teamLeadTeams UIDs so the API can query events from all teams
        if (state.teamLeadTeams && state.teamLeadTeams.length > 0) {
            var teamUids = [];
            for (var i = 0; i < state.teamLeadTeams.length; i++) {
                teamUids.push(String(state.teamLeadTeams[i].user_id));
            }
            url += '&team_uids=' + encodeURIComponent(JSON.stringify(teamUids));
        }
        // Pass user's personal UID for member events query
        if (state.userUid) {
            url += '&user_uid=' + encodeURIComponent(String(state.userUid));
        }
        // Pass is_team_member flag for view-only mode
        if (state.isTeamMember) {
            url += '&is_team_member=1';
        }
        return url;
    },
    buildMemberUpdateRequest: function(operation, memberUserId, state) {
        return {
            url: '<?= $this->url('user/teamlead-team-members') ?>',
            body: new URLSearchParams({
                operation: operation,
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                member_user_id: String(memberUserId)
            })
        };
    },
    buildOrderRelevanceUpdateRequest: function(drinkId, unitPrice, memberUserIds, state) {
        return {
            url: '<?= $this->url('user/teamlead-order-relevance') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                drink_id: String(drinkId),
                unit_price: String(unitPrice),
                member_user_ids: String((memberUserIds || []).join(','))
            })
        };
    },
    buildExtraCostCreateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-extra-cost') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                payer_user_id: String(payload.payerUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || ''),
                relevant_member_ids: String((payload.relevantMemberIds || []).join(','))
            })
        };
    },
    buildExtraCostUpdateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-update-extra-cost') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                extra_cost_id: String(payload.extraCostId || 0),
                team_event_id: String(state.currentEventId),
                payer_user_id: String(payload.payerUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || ''),
                relevant_member_ids: String((payload.relevantMemberIds || []).join(','))
            })
        };
    },
    buildExtraCostDeleteRequest: function(extraCostId, state) {
        return {
            url: '<?= $this->url('user/teamlead-delete-extra-cost') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                extra_cost_id: String(extraCostId || 0),
                team_event_id: String(state.currentEventId)
            })
        };
    },
    buildGuestDonationCreateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-guest-donation') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                team_event_id: String(state.currentEventId),
                receiver_user_id: String(payload.receiverUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || '')
            })
        };
    },
    buildGuestDonationUpdateRequest: function(payload, state) {
        return {
            url: '<?= $this->url('user/teamlead-update-guest-donation') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                guest_donation_id: String(payload.guestDonationId || 0),
                team_event_id: String(state.currentEventId),
                receiver_user_id: String(payload.receiverUserId || 0),
                amount: String(payload.amount || 0),
                comment: String(payload.comment || '')
            })
        };
    },
    buildGuestDonationDeleteRequest: function(guestDonationId, state) {
        return {
            url: '<?= $this->url('user/teamlead-delete-guest-donation') ?>',
            body: new URLSearchParams({
                team_uid: String(state.teamUid),
                guest_donation_id: String(guestDonationId || 0),
                team_event_id: String(state.currentEventId)
            })
        };
    },
    buildCloseEventRequest: function(state, settlement) {
        var body = new URLSearchParams({
            team_uid: String(state.teamUid),
            team_event_id: String(state.currentEventId)
        });
        if (settlement && Array.isArray(settlement.refunds) && settlement.refunds.length > 0) {
            body.set('settlement_refunds', JSON.stringify(settlement.refunds));
        }
        return {
            url: '<?= $this->url('user/teamlead-close-team-event') ?>',
            body: body
        };
    },
    afterLoadData: function(data, state, refs) {
        if (data.team_alias) {
            state.teamAlias = String(data.team_alias);
        }
        // Store canManageMembers flag for controlling UI editing
        // Determine from the selected event's can_manage_members field
        var selectedEvent = null;
        var events = Array.isArray(data.events) ? data.events : [];
        for (var i = 0; i < events.length; i++) {
            if (String(events[i].label || '') === (data.spieltag || '')) {
                selectedEvent = events[i];
                break;
            }
        }
        if (!selectedEvent && events.length > 0) {
            selectedEvent = events[0];
        }
        if (selectedEvent && typeof selectedEvent.can_manage_members !== 'undefined') {
            state.canManageMembers = !!selectedEvent.can_manage_members;
        }
        // Store user role for title display
        state.userRole = data.user_role || '';
        // Fallback to global if API didn't return user_role
        if (!state.userRole && typeof window.__frontendTeamStatsUserRole !== 'undefined') {
            state.userRole = window.__frontendTeamStatsUserRole || '';
        }
        // Store event-to-team-alias mapping
        state.eventTeamAliases = {};
        var events = Array.isArray(data.events) ? data.events : [];
        for (var i = 0; i < events.length; i++) {
            var event = events[i];
            var eventId = parseInt(event.id || 0, 10);
            if (eventId > 0 && event.team_alias) {
                state.eventTeamAliases[eventId] = String(event.team_alias);
            }
        }
        if (refs.select) {
            while (refs.select.firstChild) {
                refs.select.removeChild(refs.select.firstChild);
            }
            var openSpieltage = Array.isArray(data.open_spieltage) ? data.open_spieltage : [];
            var selectedSpieltag = data.spieltag || '';
            
            // Handle both flat events array and grouped events by team
            var flatEvents = [];
            if (Array.isArray(events)) {
                // Check if events are grouped by team (object with team keys)
                var isGrouped = events.length > 0 && typeof events[Object.keys(events)[0]] === 'object' && events[Object.keys(events)[0]].events !== undefined;
                if (isGrouped) {
                    // Flatten grouped events, sorting each team's events by id descending
                    var teamKeys = Object.keys(events);
                    for (var t = 0; t < teamKeys.length; t++) {
                        var teamData = events[teamKeys[t]];
                        var teamEvents = Array.isArray(teamData.events) ? teamData.events : [];
                        // Sort events within each team by id descending (newest first)
                        teamEvents.sort(function(a, b) { return (b.id || 0) - (a.id || 0); });
                        // Merge team info into each event
                        for (var e = 0; e < teamEvents.length; e++) {
                            teamEvents[e].team_alias = teamData.team_alias;
                            teamEvents[e].team_admin_user_id = teamData.team_admin_user_id;
                        }
                        flatEvents = flatEvents.concat(teamEvents);
                    }
                } else {
                    flatEvents = events;
                }
            }
            
            // Sort all events by id descending (newest first)
            flatEvents.sort(function(a, b) { return (b.id || 0) - (a.id || 0); });
            
            for (var i2 = 0; i2 < flatEvents.length; i2++) {
                var event2 = flatEvents[i2];
                var name = String(event2.label || '').trim();
                if (!name) continue;
                var teamAlias = String(event2.team_alias || '').trim();
                var displayText = teamAlias ? (teamAlias + ' - ' + name) : name;
                var opt = document.createElement('option');
                opt.value = name;
                opt.setAttribute('data-event-id', event2.id || '');
                opt.setAttribute('data-team-alias', teamAlias || '');
                // Add data-user-role based on can_manage_members for this event
                var canManage = (typeof event2.can_manage_members !== 'undefined') ? !!event2.can_manage_members : false;
                var eventUserRole = canManage ? 'Mannschaftsführer' : 'Mitglied';
                opt.setAttribute('data-user-role', eventUserRole);
                var isOpen = openSpieltage.indexOf(name) !== -1;
                opt.textContent = isOpen ? (displayText + ' (offen)') : displayText;
                if (name === selectedSpieltag) opt.selected = true;
                refs.select.appendChild(opt);
            }
            refs.select.disabled = flatEvents.length === 0;
        }
    }
});

function openFrontendTeamStatsModal(teamLeadTeams, isTeamMember, userUid) {
    return frontendTeamStatsModalController.open(teamLeadTeams, isTeamMember, userUid);
}

function loadFrontendTeamStatsForSpieltag(spieltag) {
    return frontendTeamStatsModalController.load(spieltag);
}

function closeFrontendTeamStatsModal() {
    frontendTeamStatsModalController.close();
}
</script>
