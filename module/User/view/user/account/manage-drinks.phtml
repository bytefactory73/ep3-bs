<script>
document.addEventListener('change', function (e) {
    var input = e.target;
    if (!input || input.type !== 'file' || input.id.indexOf('drink-image-') !== 0) {
        return;
    }
    if (!input.files || input.files.length === 0) {
        return;
    }
    var formId = input.getAttribute('form');
    if (!formId) {
        return;
    }
    var autoSaveBtn = document.getElementById(formId + '-auto-save');
    if (!autoSaveBtn) {
        return;
    }
    autoSaveBtn.click();
});
</script>
