        font-weight: bold;
        text-align: left;
    }
</style>
    <thead>
        <tr>
            <th><?= $this->t('Benutzer') ?></th>
            <th><?= $this->t('E-Mail') ?></th>
            <th><?= $this->t('Datum') ?></th>
            <th><?= $this->t('Kontostand') ?></th>
        </tr>
