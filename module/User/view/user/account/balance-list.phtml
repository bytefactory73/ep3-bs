                    <?= $this->escapeHtml(date('d.m.Y H:i', strtotime($user['last_activity']))) ?>
                <?php else: ?>
                    &ndash;
                <?php endif; ?>
            </td>
            <td style="font-weight:bold; color:<?= $user['balance'] < 0 ? '#d32f2f' : '#388e3c' ?>;">
                <?= number_format($user['balance'], 2, ',', '.') ?> €
            </td>
        </tr>
    <?php endforeach; ?>
    </tbody>
</table>
