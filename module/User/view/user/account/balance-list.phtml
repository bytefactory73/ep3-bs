            <td style="font-weight:bold; color:<?= $user['balance'] < 0 ? '#d32f2f' : '#388e3c' ?>;">
                <?= number_format($user['balance'], 2, ',', '.') ?> €
            </td>
            <td style="font-weight:bold; color:#333; text-align:right;">
                <?php if (isset($user['orders_total'])): ?>
                    <?= number_format($user['orders_total'], 2, ',', '.') ?> €
