// Party Mode early block (with timeframe gating) - uses option() helper per key
$__partyModeEnabled = false; $__partyModeMessage = ''; $__partyModeStart=''; $__partyModeEnd='';
try {
    try { $__partyModeEnabledRaw = $this->option('party_mode.enabled', false); } catch (RuntimeException $e) { $__partyModeEnabledRaw = false; }
    $__partyModeEnabledBase = ($__partyModeEnabledRaw === '1' || $__partyModeEnabledRaw === 1 || $__partyModeEnabledRaw === true);
    try { $__partyModeMessage = (string)$this->option('party_mode.message', ''); } catch (RuntimeException $e) {}
    try { $__partyModeStart = (string)$this->option('party_mode.start', ''); } catch (RuntimeException $e) {}
    try { $__partyModeEnd = (string)$this->option('party_mode.end', ''); } catch (RuntimeException $e) {}
    $now = time(); $activeWithin = true;
    $sTs = $__partyModeStart && ($ts=strtotime($__partyModeStart))!==false ? $ts : null;
    $eTs = $__partyModeEnd && ($ts=strtotime($__partyModeEnd))!==false ? $ts : null;
    if ($sTs && $now < $sTs) $activeWithin = false;
    if ($eTs && $now > $eTs) $activeWithin = false;
    $__partyModeEnabled = $__partyModeEnabledBase && $activeWithin;
} catch (Exception $e) { $__partyModeEnabled = false; }
if ($__partyModeEnabled) {
    echo '<div class="party-mode-block" style="margin:20px 0;font-size:1.2em;line-height:1.4;">' . nl2br($this->escapeHtml($__partyModeMessage ?: $this->t('Ordering is currently disabled.'))) . '</div>';
