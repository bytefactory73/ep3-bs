        <script>
        function setSummaryMode(mode) {
            localStorage.setItem('drinksSummaryMode', mode);
            // Let unified controller pick up via location reload
            var qs = new URLSearchParams(window.location.search);
            qs.set('mode', mode);
            window.location.search = qs.toString();
        }
        document.getElementById('storeCheckDateBtn').addEventListener('click', function() {
            var now = new Date();
            // Format as local time string (YYYY-MM-DDTHH:mm)
            var localStr = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0') + 'T' + String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
            var url = '<?= $this->url('user/store-check-date') ?>';
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ datetime: localStr })
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.success) {
                    // Force quick=sinceLastCheck and let unified logic enforce value
                    var qs = new URLSearchParams(window.location.search);
                    qs.set('quick','sinceLastCheck');
                    // Ensure the freshly stored check date is passed as from= so backend query is limited
                    qs.set('from', localStr);
                    // Remove any explicit "to" so it remains open-ended
                    qs.delete('to');
                    // Persist immediately to localStorage & cookies for consistency with reload logic
                    try {
                        localStorage.setItem('drinksSummaryFrom', localStr);
                        localStorage.setItem('drinksSummaryQuickRange', 'sinceLastCheck');
                        document.cookie = 'drinksSummaryFrom=' + encodeURIComponent(localStr) + ';path=/';
                        document.cookie = 'drinksSummaryQuickRange=sinceLastCheck;path=/';
                    } catch(e) { /* ignore storage errors */ }
                    window.location.search = qs.toString();
                }
            })
            .catch(function() { /* Message box removed */ });
        });
        </script>
        <?php
        // --- Optimized: Pre-pass to calculate colSums for all drinks, then determine activeDrinks ---
        $colSums = [];
        foreach ($this->drinks as $drink) {
            $colSums[$drink['id']] = 0;
        }
        foreach ($this->orders as $date => $userOrders) {
            foreach ($userOrders as $uid => $drinks) {
                foreach ($drinks as $did => $cell) {
                    $val = $this->mode === 'amount' ? $cell['amount'] : $cell['count'];
                    $val = str_replace(['.', ','], ['', '.'], $val);
                    if ($val !== '' && is_numeric($val)) {
                        $colSums[$did] += (float)$val;
                    }
                }
            }
        }
        $activeDrinks = $this->drinks;
        if ($this->show_emptycols !== '1') {
            $activeDrinks = array_filter($this->drinks, function($drink) use ($colSums) {
                return isset($colSums[$drink['id']]) && $colSums[$drink['id']] != 0;
            });
        }
