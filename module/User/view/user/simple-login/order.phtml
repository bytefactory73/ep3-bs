            <select id="team-stats-spieltag-select" style="font-size:1em; max-width:100%; min-width:220px; padding:4px 6px; border:1px solid #2196f3; border-radius:6px; color:#1769aa;"></select>
        </div>
        <div id="teamStatsContent" style="padding:2px 4px 8px 4px;"></div>
