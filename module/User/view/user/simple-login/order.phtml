// Party-Mode early block (prefer controller-provided computed state, else compute with timeframe)
if (!isset($partyModeEnabled) || !isset($partyModeMessage)) {
    $partyModeEnabled = false; $partyModeMessage = ''; $partyModeStart=''; $partyModeEnd='';
    try { $rawEnabled = $this->option('party_mode.enabled', false); $partyModeEnabledBase = ($rawEnabled === '1' || $rawEnabled === 1 || $rawEnabled === true); } catch (\RuntimeException $e) { $partyModeEnabledBase = false; }
    try { $partyModeMessage = trim((string)$this->option('party_mode.message', '')); } catch (\RuntimeException $e) {}
    try { $partyModeStart = (string)$this->option('party_mode.start', ''); } catch (\RuntimeException $e) {}
    try { $partyModeEnd = (string)$this->option('party_mode.end', ''); } catch (\RuntimeException $e) {}
    $now = time(); $activeWithin = true;
    $sTs = $partyModeStart && ($ts=strtotime($partyModeStart))!==false ? $ts : null;
    $eTs = $partyModeEnd && ($ts=strtotime($partyModeEnd))!==false ? $ts : null;
    if ($sTs && $now < $sTs) $activeWithin = false;
    if ($eTs && $now > $eTs) $activeWithin = false;
    $partyModeEnabled = $partyModeEnabledBase && $activeWithin;
}
if (isset($partyModeActive)) { // controller may pass both
    $partyModeEnabled = $partyModeActive; // respect computed active state from controller
}
if ($partyModeEnabled) {
    $pmRawMsg = $partyModeMessage ?: 'Buchungen sind vorübergehend deaktiviert.';
    $pmLines = preg_split('/\r?\n/', $pmRawMsg);
    $pmFirstLine = '';
    $pmRemainder = '';
    if ($pmLines && count($pmLines) > 0) {
        $pmFirstLine = trim(array_shift($pmLines));
        $pmRemainder = trim(implode("\n", $pmLines));
    }
