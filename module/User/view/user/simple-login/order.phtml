</div>
<script>
function getTeamStatsSpieltagOptions() {
    var bookingSelect = document.getElementById('spieltag-select');
    var options = [];
    if (!bookingSelect) return options;

    for (var i = 0; i < bookingSelect.options.length; i++) {
        var option = bookingSelect.options[i];
        var value = String(option && option.value ? option.value : '').trim();
        if (!value || value === '__new__') continue;
        options.push(value);
    }

    return options;
}

function syncTeamStatsSpieltagSelect(preferredValue) {
    var modalSelect = document.getElementById('team-stats-spieltag-select');
    if (!modalSelect) return '';

    var options = getTeamStatsSpieltagOptions();
    while (modalSelect.firstChild) {
        modalSelect.removeChild(modalSelect.firstChild);
    }

    for (var i = 0; i < options.length; i++) {
        var value = options[i];
        var opt = document.createElement('option');
        opt.value = value;
        opt.textContent = value;
        modalSelect.appendChild(opt);
    }

    var selected = String(preferredValue || '').trim();
    if (!selected || options.indexOf(selected) === -1) {
        selected = options.length > 0 ? options[0] : '';
    }
    if (selected) {
        modalSelect.value = selected;
    }

    return selected;
}

window.teamSpieltagUpdateFromApi = function(data) {
    var select = document.getElementById('spieltag-select');
    if (!select || !data || !data.success) return;
    var selected = data.current_spieltag || '';
    var options = Array.isArray(data.spieltage) ? data.spieltage : [];

    while (select.firstChild) {
        select.removeChild(select.firstChild);
    }
    for (var i = 0; i < options.length; i++) {
        var name = String(options[i] || '').trim();
        if (!name) continue;
        var opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        if (name === selected) opt.selected = true;
        select.appendChild(opt);
    }
    var newOpt = document.createElement('option');
    newOpt.value = '__new__';
    newOpt.textContent = 'Neuen Spieltag anlegen';
    select.appendChild(newOpt);

    syncTeamStatsSpieltagSelect(selected);
};

function teamStatsFormatCurrency(value) {
    return Number(value || 0).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
}

function teamStatsAmountColor(value) {
    var amount = Number(value || 0);
    if (amount > 0) return '#2e7d32';
    if (amount < 0) return '#c62828';
    return '#333';
}

function teamStatsEscapeHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

async function openTeamStatsModal() {
    var modal = document.getElementById('teamStatsModal');
    var content = document.getElementById('teamStatsContent');
    if (!modal || !content) return;

    modal.style.display = 'flex';
    var bookingSelect = document.getElementById('spieltag-select');
    var preferredSpieltag = bookingSelect ? (bookingSelect.value || '') : '';
    var selectedSpieltag = syncTeamStatsSpieltagSelect(preferredSpieltag);
    await loadTeamStatsForSpieltag(selectedSpieltag);
}

async function loadTeamStatsForSpieltag(selectedSpieltag) {
    var content = document.getElementById('teamStatsContent');
    if (!content) return;

    content.innerHTML = '<div style="color:#1769aa;">Lade Daten...</div>';

    try {
        if (!selectedSpieltag || selectedSpieltag === '__new__') {
            throw new Error('Bitte zuerst einen Spieltag auswählen.');
        }

        var resp = await fetch('simple-order/team-stats?spieltag=' + encodeURIComponent(selectedSpieltag), {
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        var data = await resp.json();
        if (!resp.ok || !data || !data.success) {
            throw new Error((data && data.error) ? data.error : 'Fehler beim Laden der Statistik.');
        }

        var rows = Array.isArray(data.rows) ? data.rows : [];
        var spieltagLabel = data.spieltag || selectedSpieltag;
        var html = '';
        html += '<div style="margin-bottom:8px; color:#1769aa; font-weight:bold;">Spieltag: ' + teamStatsEscapeHtml(spieltagLabel) + '</div>';
        if (rows.length === 0) {
            html += '<div style="color:#555;">Keine Eintraege fuer diesen Spieltag.</div>';
        } else {
            html += '<table class="default-table" style="width:100%; margin:0;">';
            html += '<tr style="background:#e3f0fa;">';
            html += '<th style="text-align:left;">Artikel</th>';
            html += '<th style="text-align:right;">Menge</th>';
            html += '<th style="text-align:right;">Einzelpreis</th>';
            html += '<th style="text-align:right;">Gesamtpreis</th>';
            html += '</tr>';

            for (var i = 0; i < rows.length; i++) {
                var row = rows[i] || {};
                html += '<tr>';
                html += '<td>' + teamStatsEscapeHtml(row.article || '') + '</td>';
                html += '<td style="text-align:right;">' + teamStatsEscapeHtml(row.quantity || 0) + '</td>';
                html += '<td style="text-align:right; color:' + teamStatsAmountColor(row.single_price) + ';">' + teamStatsFormatCurrency(row.single_price) + '</td>';
                html += '<td style="text-align:right; color:' + teamStatsAmountColor(row.total_price) + ';">' + teamStatsFormatCurrency(row.total_price) + '</td>';
                html += '</tr>';
            }

            html += '<tr style="font-weight:bold; background:#f5faff;">';
            html += '<td colspan="3" style="text-align:right;">Gesamtsumme</td>';
            html += '<td style="text-align:right; color:' + teamStatsAmountColor(data.total_sum) + ';">' + teamStatsFormatCurrency(data.total_sum) + '</td>';
            html += '</tr>';
            html += '</table>';
        }
        content.innerHTML = html;
    } catch (err) {
        content.innerHTML = '<div style="color:#d32f2f;">' + teamStatsEscapeHtml(err && err.message ? err.message : 'Fehler beim Laden der Statistik.') + '</div>';
    }
}

function closeTeamStatsModal() {
    var modal = document.getElementById('teamStatsModal');
    if (modal) modal.style.display = 'none';
}

document.addEventListener('DOMContentLoaded', function() {
    var modalSelect = document.getElementById('team-stats-spieltag-select');
    if (!modalSelect) return;

    modalSelect.addEventListener('change', function() {
        var selected = modalSelect.value || '';
        loadTeamStatsForSpieltag(selected);
    });
});

function openDrinksSummaryModal() {
    var now = new Date();
    var fromDateObj = new Date(now.getTime() - 6 * 24 * 60 * 60 * 1000);
    var fromDate = fromDateObj.toISOString().slice(0, 10);
    // Open summary with explicit quick range and mode so UI reflects state immediately
    var summaryUrl = './drinks-summary?quick=sinceLastCheck&mode=count';
    document.getElementById('drinksSummaryModal').style.display = 'flex';
    document.getElementById('drinksSummaryFrame').src = summaryUrl;
    // Reset logout timer to 30 minutes if in simple order mode
    if (window.SIMPLE_ORDER_MODE && typeof localStorage !== 'undefined') {
        var deadlineKey = 'simpleOrderLogoutDeadline';
        var LOGOUT_DELAY = 30 * 60 * 1000; // 30 minutes
        var deadline = Date.now() + LOGOUT_DELAY;
        localStorage.setItem(deadlineKey, deadline);
        if (typeof startLogoutTimer === 'function') {
            startLogoutTimer();
        }
    }
}
function closeDrinksSummaryModal() {
    document.getElementById('drinksSummaryModal').style.display = 'none';
    document.getElementById('drinksSummaryFrame').src = '';
}
</script>
