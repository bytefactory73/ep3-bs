<script>
function openDrinksSummaryModal() {
    var now = new Date();
    var fromDateObj = new Date(now.getTime() - 6 * 24 * 60 * 60 * 1000);
    var fromDate = fromDateObj.toISOString().slice(0, 10);
    // Open summary with explicit quick range and mode so UI reflects state immediately
    var summaryUrl = './drinks-summary?quick=sinceLastCheck&mode=count';
    document.getElementById('drinksSummaryModal').style.display = 'flex';
    document.getElementById('drinksSummaryFrame').src = summaryUrl;
    // Reset logout timer to 30 minutes if in simple order mode
    if (window.SIMPLE_ORDER_MODE && typeof localStorage !== 'undefined') {
        var deadlineKey = 'simpleOrderLogoutDeadline';
        var LOGOUT_DELAY = 30 * 60 * 1000; // 30 minutes
        var deadline = Date.now() + LOGOUT_DELAY;
        localStorage.setItem(deadlineKey, deadline);
        if (typeof startLogoutTimer === 'function') {
            startLogoutTimer();
        }
    }
}
function closeDrinksSummaryModal() {
    document.getElementById('drinksSummaryModal').style.display = 'none';
    document.getElementById('drinksSummaryFrame').src = '';
}
</script>
